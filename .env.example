# PostgreSQL acessível pela internet (provedor externo ou Netlify DB).
# Se usar Netlify DB, NETLIFY_DB_URL pode ser fornecida pela plataforma.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Proteção HTTP Basic para o painel interno da oficina.
SITE_USERNAME=oficina
SITE_PASSWORD=troque-por-uma-senha-forte
